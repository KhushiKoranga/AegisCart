# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
NODE_ENV=development
# Comma separated list of allowed web origins (mobile apps do not need CORS)
CORS_ORIGINS=http://localhost:8081

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aegiscart

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Unpaid orders keep their reserved stock for this many minutes
RESERVATION_MINUTES=15

# Razorpay (test mode keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Email (Nodemailer, any SMTP server). Leave SMTP_HOST empty to disable emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
EMAIL_FROM=AegisCart <your_email@example.com>

# Firebase Cloud Messaging. Path to the service account JSON downloaded from Firebase.
# Leave empty to disable push notifications.
FIREBASE_SERVICE_ACCOUNT_PATH=

# AI Virtual Try-On (Replicate hosts the IDM-VTON model)
REPLICATE_API_TOKEN=
# Version id from the model's page on replicate.com (see README for how to find it)
REPLICATE_MODEL_VERSION=
# Uploaded photos and unsaved previews are deleted after this many hours
TRYON_RETENTION_HOURS=24
# Folder for private try-on images (outside any public web folder)
PRIVATE_STORAGE_DIR=./storage/private

# Used only by: npm run create-admin
ADMIN_EMAIL=admin@aegiscart.test
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=Store Admin
